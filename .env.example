# ── Twilio Credentials ────────────────────────────────
# Found at: https://console.twilio.com

# Your Twilio Account SID (starts with AC...)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio Auth Token
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio API Key SID (create at: Console > Account > API Keys)
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Twilio API Key Secret (shown once at creation)
TWILIO_API_SECRET=your_api_secret_here

# Your Twilio phone number (E.164 format)
TWILIO_PHONE_NUMBER=+15550000000

# TwiML App SID (create at: Console > Voice > TwiML Apps)
# Set the Voice Request URL to: https://your-domain.com/voice/inbound
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Server Config ──────────────────────────────────────
# Public base URL of your server (Railway URL in production)
BASE_URL=https://your-railway-app.up.railway.app

PORT=3001

# React dev server origin (Vite default)
CLIENT_ORIGIN=http://localhost:5173
